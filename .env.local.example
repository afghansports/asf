# Copy to .env.local and fill in. Real production values go in Vercel.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser. Everything else is server-only.

# ---------- Supabase (required) ----------
NEXT_PUBLIC_SUPABASE_URL=https://pyhdnfwdmibhnfyyozsw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from Supabase dashboard>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase dashboard, server-only>

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Afghan Sports Federation
ADMIN_EMAILS=agdcvakbl@gmail.com
CRON_SECRET=<generate a 32-char random string>

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=noreply@afghansportsfederation.com
EMAIL_ADMIN=agdcvakbl@gmail.com

# ---------- Analytics (Plausible) ----------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=afghansportsfederation.com
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ---------- Sentry (error tracking) ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Web push (browser notifications) ----------
# Sample keys — generate fresh ones for production with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BIIPt1KO_4OJSk4S9Ci2Gpo2vObkdy7HGAHyWO2sYmbWXKCNB_zW0Me_sLCn-pd1YuG1hZEDe7Xa2gsuzJsw3l0
VAPID_PRIVATE_KEY=0l1A9V8MQcQwONx3GRy3-t8EiLj3ckhj3DvzF_n5xTI
VAPID_SUBJECT=mailto:safeguarding@asf.org

# ---------- Mux (video ingest, optional) ----------
# Without these, /reels/upload uses Supabase Storage directly.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ---------- Cloudflare CDN (optional) ----------
# Without this, image/video URLs resolve directly from Supabase Storage.
NEXT_PUBLIC_CDN_BASE=

# ---------- CSAM scanning (child safety) ----------
# REQUIRED before opening public photo/video upload. Integration is a seam
# (lib/safety/csam.ts) and is NOT yet enforced — see compliance/DPIA.md R-1.
# Set all three to enable, then wire scanning at a server-side upload point.
CSAM_PROVIDER=
CSAM_PROVIDER_URL=
CSAM_PROVIDER_KEY=
